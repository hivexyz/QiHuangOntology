# QiHuang Shield backend runtime config
# Copy to `.env` and fill these values manually.

# Storage backend: memory | database
# Use `database` when enabling PostgreSQL + Neo4j.
QHS_STORAGE_BACKEND=database

# Whether to auto-create tables / constraints / seed demo data on first startup.
# Recommended for local development: true
# Recommended for shared / production-like environments: false
QHS_DB_AUTO_INIT=true

# Whether to inject demo tenant / users / policies / ontology assets.
# Keep this disabled by default outside isolated local development.
QHS_ENABLE_DEMO_SEED=false

# PostgreSQL connection string
# Format:
# postgresql://<username>:<password>@<host>:<port>/<database>
QHS_POSTGRES_DSN=postgresql://__PG_USER__:__PG_PASSWORD__@__PG_HOST__:5432/__PG_DATABASE__

# Neo4j Bolt connection
# Format:
# bolt://<host>:<port>
QHS_NEO4J_URI=bolt://__NEO4J_HOST__:7687
QHS_NEO4J_USER=__NEO4J_USER__
QHS_NEO4J_PASSWORD=__NEO4J_PASSWORD__
QHS_NEO4J_DATABASE=neo4j

# Browser CORS allowlist regex
# For local frontend debugging, the default below is enough.
QHS_CORS_ALLOW_ORIGIN_REGEX=http://(127\\.0\\.0\\.1|localhost)(:\\d+)?

# LLM extraction for guideline import (OpenAI-compatible endpoint)
# Set to true to prefer LLM extraction; when the call fails, backend falls back to rules.
QHS_LLM_ENABLED=false
QHS_LLM_BASE_URL=https://api.openai.com/v1
QHS_LLM_ENDPOINT=/chat/completions
QHS_LLM_API_KEY=__LLM_API_KEY__
QHS_LLM_MODEL=__LLM_MODEL__
QHS_LLM_TIMEOUT_SECONDS=60
